      "id": "file:src/api/client.js",
      "type": "file",
      "name": "client.js",
      "filePath": "src/api/client.js",
      "summary": "Central API client wrapper that stores the JWT in localStorage, injects the Authorization header on every request via apiFetch, and dispatches an auth:unauthorized window event on 401 responses so AuthContext can log the user out and redirect to /login.",
      "tags": ["api-client", "authentication", "utility", "http"],
      "complexity": "simple",
      "languageNotes": "Uses a custom window event (auth:unauthorized) as a decoupled signal so a low-level fetch wrapper can trigger app-level logout without importing React context directly."
    },
    {
      "id": "function:src/api/client.js:getToken",
