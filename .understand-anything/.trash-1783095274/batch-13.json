  "nodes": [
    {
      "id": "document:docs/superpowers/specs/2026-04-20-file-upload-rag-ingestion-design.md",
      "type": "document",
      "name": "2026-04-20-file-upload-rag-ingestion-design.md",
      "filePath": "docs/superpowers/specs/2026-04-20-file-upload-rag-ingestion-design.md",
      "summary": "Approved v1 design spec for file upload and ingestion: a five-service pipeline (React, FastAPI, Redis, Celery worker, PostgreSQL+pgvector) that saves an uploaded PDF/DOCX/image, parses and chunks it, embeds chunks via OpenAI, and notifies the client over SSE when ingestion completes. Documents the original `documents`/`document_chunks` schema, the upload/status API contract, and the specific backend and frontend files the feature touches.",
      "tags": ["documentation", "design-spec", "file-upload", "ingestion", "rag"],
      "complexity": "moderate",
      "languageNotes": "Early v1 spec — predates OCR support and the later agentic RAG / parent-child chunking enhancements described in the 2026-05-15 spec."
    },
    {
      "id": "document:docs/superpowers/specs/2026-05-04-agentic-rag-design.md",
      "type": "document",
      "name": "2026-05-04-agentic-rag-design.md",
      "filePath": "docs/superpowers/specs/2026-05-04-agentic-rag-design.md",
      "summary": "Approved-but-superseded design spec for the original 'chat with document' feature: a ReAct agent (qwen3 via Ollama) that iteratively calls a vector-search tool before streaming a grounded answer with citations, plus the DocumentSelector UI, useChat streaming hook, and SSE token/citations/done protocol. Carries a historical note that the stack later moved off Ollama to OpenRouter-hosted models.",
      "tags": ["documentation", "design-spec", "agentic-rag", "chat", "historical"],
      "complexity": "complex",
      "languageNotes": "Superseded in part by the 2026-05-15 enhancement spec, which replaces this design's single ReAct tool-loop with a multi-node LangGraph state machine."
    },
    {
      "id": "document:docs/superpowers/specs/2026-05-15-agentic-rag-enhancement-design.md",
      "type": "document",
      "name": "2026-05-15-agentic-rag-enhancement-design.md",
      "filePath": "docs/superpowers/specs/2026-05-15-agentic-rag-enhancement-design.md",
      "summary": "Design spec for the agentic RAG enhancement that replaces the single `rag.py` with the `backend/app/services/rag/` LangGraph package: parent-child chunking, hybrid (vector + FTS) retrieval fused via RRF and reranked with a cross-encoder, and a six-node CRAG-lite state machine (rewrite_query, retrieve_and_rerank, grade_chunks, rewrite_and_retry, generate_answer, faithfulness_check), plus a RAGAS-based evaluation harness and a four-phase rollout plan. This is the architecture CLAUDE.md currently describes as production, with a historical note that the model substrate later moved from Ollama/TEI to OpenRouter.",
      "tags": ["documentation", "design-spec", "agentic-rag", "retrieval", "evaluation"],
      "complexity": "complex",
      "languageNotes": "Describes a LangGraph StateGraph with conditional edges (grade -> answer | retry | give_up) implementing a Corrective-RAG-lite pattern; also introduces token-based (tiktoken) parent/child chunk sizing in place of character-based splitting."
    }
  ],
