      "id": "file:src/auth/AuthContext.jsx",
      "type": "file",
      "name": "AuthContext.jsx",
      "filePath": "src/auth/AuthContext.jsx",
      "summary": "Defines the AuthContext and AuthProvider component that own token/user/loading state, validate a persisted token on mount, react to a global unauthorized event, and expose login/logout plus the useAuth hook to the rest of the app.",
      "tags": ["authentication", "context", "state-management", "react-context"],
      "complexity": "moderate",
      "languageNotes": "Uses React context + a custom useAuth hook (the standard provider/consumer pattern) and a window CustomEvent ('auth:unauthorized') as a lightweight cross-component signal so the API client can force a logout without a direct dependency on this file."
    },
    {
      "id": "function:src/auth/AuthContext.jsx:AuthProvider",
      "type": "function",
      "name": "AuthProvider",
      "filePath": "src/auth/AuthContext.jsx",
      "lineRange": [7, 73],
      "summary": "Provider component holding token/user/loading state; on mount it revalidates a stored token via getMe, clears state on 'auth:unauthorized' events, and exposes memoized login/logout callbacks through context.",
      "tags": ["authentication", "provider", "state-management", "context"],
      "complexity": "moderate"
    },
    {
      "id": "function:src/auth/AuthContext.jsx:useAuth",
      "type": "function",
      "name": "useAuth",
      "filePath": "src/auth/AuthContext.jsx",
      "lineRange": [76, 80],
      "summary": "Hook that reads AuthContext and throws if called outside an AuthProvider, giving consumers access to token, user, loading, isAuthenticated, login, and logout.",
      "tags": ["hook", "authentication", "custom-hook"],
      "complexity": "simple"
    },
