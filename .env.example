DATABASE_URL=postgresql+psycopg2://chatbot:chatbot@db:5432/chatbot
REDIS_URL=redis://redis:6379/0

# Ollama (chat + embedding). Use host.docker.internal from inside the backend
# container (Mac/Windows Docker Desktop); on Linux use --add-host or bridge IP.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q8_0

# Reranker. Served by HuggingFace TEI (see docker-compose `reranker` service).
# In-compose: http://reranker:80. To use a remote/bigger TEI box, override
# this URL. The model is set on TEI's CLI (--model-id); RERANKER_MODEL is
# informational (shows up in logs).
RERANKER_BASE_URL=http://reranker:80
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000
