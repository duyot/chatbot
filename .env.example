DATABASE_URL=postgresql+psycopg2://chatbot:chatbot@db:5432/chatbot
REDIS_URL=redis://redis:6379/0

# Optional: OPENAI_API_KEY is no longer used by default (embeddings + chat
# both go through OpenRouter). Kept for forward-compat in case you flip a
# component back to OpenAI direct.
OPENAI_API_KEY=

# OpenRouter (used for chat LLM, LLM-as-reranker, AND embeddings).
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5

# Embedding model — OpenAI-compatible slug routed through OpenRouter.
# Must support OpenAI-style `dimensions` truncation if you set a smaller
# EMBEDDING_DIM than the model's native dim. (env var name kept for
# back-compat.)
OPENAI_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=1536

# Reranker now uses OpenRouter LLM (no TEI dependency). Defaults to the same
# model as OPENROUTER_CHAT_MODEL; override here to use a stronger model for
# ranking only (e.g. anthropic/claude-sonnet-4.6).
RERANKER_MODEL=anthropic/claude-haiku-4.5

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000

# Auth: signing key for login JWTs. REQUIRED in production. Generate with:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me
# Optional overrides (defaults shown):
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OCR (PaddleOCR microservice). The worker calls this over HTTP for scanned
# PDF pages and image uploads; digital PDFs use the native text layer.
OCR_ENABLED=true
OCR_SERVICE_URL=http://ocr:8080
OCR_TIMEOUT_S=60
# PDF pages with fewer than this many non-whitespace chars are treated as
# scanned and sent to OCR.
OCR_MIN_TEXT_CHARS=20
# Render DPI for rasterizing scanned PDF pages before OCR.
OCR_DPI=200

# Metadata-aware rerank boost (defaults are no-ops; tune via the eval harness).
RERANK_NATIVE_BOOST=0.0
RERANK_LOWCONF_PENALTY=0.0
RERANK_LOWCONF_THRESHOLD=0.5

# AI trace log (logs/ai_trace.jsonl) — retrieved chunks, reranker I/O, prompts
# sent to OpenRouter, token usage, per-stage latency. See CLAUDE.md.
#   off     - emit nothing
#   summary - ids/scores/tokens/latency, text truncated (default)
#   full    - complete prompts and candidate documents. Writes document content
#             to disk; enable per debugging session, not in production.
AI_TRACE_LEVEL=summary
AI_TRACE_TEXT_CHARS=200
AI_TRACE_FILE=/app/logs/ai_trace.jsonl
