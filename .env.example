DATABASE_URL=postgresql+psycopg2://chatbot:chatbot@db:5432/chatbot
REDIS_URL=redis://redis:6379/0

# Ollama (chat + embedding). Use host.docker.internal from inside the backend
# container (Mac/Windows Docker Desktop); on Linux use --add-host or bridge IP.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q8_0

# Reranker. Separate URL so chat/embedding can point at a remote/bigger box
# while reranking stays local for low latency.
RERANKER_BASE_URL=http://host.docker.internal:11434
RERANKER_MODEL=qllama/bge-reranker-v2-m3:q8_0

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000
